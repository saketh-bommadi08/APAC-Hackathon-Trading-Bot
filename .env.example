ROOSTOO_BASE_URL=https://mock-api.roostoo.com
ROOSTOO_API_KEY=YOUR_TEST_KEY
ROOSTOO_SECRET_KEY=YOUR_TEST_SECRET

# The research-selected portfolio. Keep this unchanged unless the project decision changes.
ROOSTOO_PAIRS=TRX/USD,AVAX/USD,DOT/USD

DRY_RUN=true
ALLOW_LIVE_TRADING=false

POLL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
READ_RETRIES=2
RETRY_BASE_SECONDS=1
MAX_RETRY_DELAY_SECONDS=8
SERVER_TIME_REFRESH_SECONDS=300
MAX_CLOCK_OFFSET_MS=30000
MAX_TICKER_AGE_SECONDS=90
MAX_CANDLE_GAP_SECONDS=4500

BINANCE_WARMUP_DAYS=7
BINANCE_TIMEOUT_SECONDS=10
